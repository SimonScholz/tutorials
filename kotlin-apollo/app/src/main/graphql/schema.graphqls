type PickRunLineItem implements MandatoryLineItem & LineItem {
  """
  The reason for a short pick on this line item.
  """
  shortPickReason: PickLineShortPickReason

  """
  The id of this lineItem. It is generated during creation automatically and suits as the primary identifier of the described entity.
  """
  id: ID!

  """
  The amount of articles that were picked for this pickline.
  """
  picked: Int!

  """
  The time at which the pickline was picked (ex 2024-11-05T10:30:00Z).
  """
  pickedAt: GraphQLISODateTime

  """
  The status of the line item. Can be either OPEN, INPROGRESS or CLOSED.
  """
  status: PickLineItemStatus!

  """
  Information about the article of this line item.
  """
  article: PickLineItemArticle!

  """
  Identifier for items unit of measurement.
  """
  measurementUnitKey: String

  """
  Measurement Unit in the locale of the requesting client. If no locale is provided, the tenant default locale will be used. If that is also not available 'en_US' will be used.
  """
  measurementUnit(locale: String @deprecated(reason: "locale from user will be considered")): MeasurementUnit

  """
  The quantity of the article to be picked.
  """
  quantity: Int!

  """
  The measurement unit key for the secondary quantity (e.g., 'kg' when primary is 'pieces').
  """
  secondaryMeasurementUnitKey: String

  """
  The secondary measurement unit in the locale of the requesting client. If no locale is provided, the tenant default locale will be used. If that is also not available 'en_US' will be used.
  """
  secondaryMeasurementUnit(locale: String @deprecated(reason: "locale from user will be considered")): MeasurementUnit

  """
  Configuration defining validation rules for measurement units for soft and hard upper and lower boundaries.
  """
  measurementValidation: MeasurementValidation

  """
  The quantity in the secondary measurement unit (e.g., weight in kg when primary is piece count).
  """
  secondaryQuantity: Int

  """
  The amount picked in the secondary measurement unit.
  """
  secondaryPicked: Int

  """
  List of articles that can be used as substitutes for this line item.
  """
  allowedSubstitutes: [AllowedSubstitute!]

  """
  Indicates whether this line item has any allowed substitutes.
  """
  hasSubstitutes: Boolean!

  """
  List of substitute articles that were actually picked for this line item.
  """
  substituteLineItems: [SubstituteLineItem!]

  """
  Barcodes or QR codes that can be scanned to identify this article.
  """
  scannableCodes: [String!]

  """
  Deprecated. Use scanningRules instead.
  """
  scanningRule: ScanningRuleConfiguration @deprecated(reason: "Use scanningRules instead")

  """
  Configuration defining scanning rules for this line item (e.g., required scans, validation rules).
  """
  scanningRules: PickLineItemScanningRules

  """
  List of codes that were actually scanned for this line item during picking.
  """
  scannedCodes: [ScannedCodes!]

  """
  Storage locations where partial quantities of this article are located.
  """
  partialStockLocations: [PickJobLineItemPartialStockLocation!]

  """
  Attributes that can be added to the orderline. These attributes cannot be used within fulfillment processes, but it could be useful to have the informations carried here.
  """
  customAttributes: GraphQLJSON

  """
  Indicates whether the stock for this line item has been completely depleted at its location. This is set by the client.
  """
  stockEmptied: Boolean

  """
  Reference to the original pick job line item this pick run line item is based on.
  """
  pickJobLineItemRef: String

  """
  Tags associated with this line item for categorization and filtering.
  """
  tags: [TagReference!]

  """
  Visual indicators or labels applied to this line item (e.g., fragile, express).
  """
  stickers: [Sticker!]

  """
  Reference to the pick job this line item belongs to.
  """
  pickJobRef: String

  """
  Customizable information about the lineItem that can be set during the process.
  """
  recordableAttributes: [RecordableAttribute!]

  """
  The id of the line item this line item was originated from, before any split has happened. This can be used to restore the ‘pre-split’ status.
  """
  originId: String

  """
  Deprecated. Use globalLineItemIds instead.
  """
  globalLineItemId: String @deprecated(reason: "Use globalLineItemIds instead.")

  """
  These Ids are used to identify if this line item is related to the line item of other operational entities.
  """
  globalLineItemIds: [String!]
}

