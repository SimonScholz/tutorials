type BaseCarrierConfiguration implements VersionedResource {
  version: Int!

  created: GraphQLISODateTime

  lastModified: GraphQLISODateTime

  carrierRef: String!

  returnLabel: Boolean!

  """
  It is an amount of percentage for packaging weight which will be added to the calculated shipping weight
  """
  additionalWeightInPercent: Float

  mustBeWeighed: Boolean

  fallBackTrackAndTraceEmail: String

  countryServiceMappings: [CarrierCountryServiceMapping]

  serviceUrl: String

  trackAndTraceUrl: String

  additionalUrl: String

  nonDeliveryDaysPerCountryAndProvince: [NonDeliveryDaysPerCountryAndProvince!]

  thresholdPriceValue: ThresholdPriceValue

  alternativeSendAddress: FacilityAddress

  alternativeReturnAddress: FacilityAddress

  """
  Default pick up time configuration for carriers supporting pick up scheduling, will be used to calculate the next possible pick up date
  """
  defaultPickUpTime: CarrierPickUpTime
}

"""
The `Float` scalar type represents signed double-precision fractional values as specified by [IEEE 754](https://en.wikipedia.org/wiki/IEEE_floating_point).
"""
scalar Float

