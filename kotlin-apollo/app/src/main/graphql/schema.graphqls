  pageInfo: PageInfo!

  edges: [FacilityDiscountEdge]

  totalCount: Int!
}

type FacilityDiscountEdge {
  cursor: String!

  node: FacilityDiscount!
}

type FacilityDiscount {
  id: ID!

  version: Int!

  created: GraphQLISODateTime

  lastModified: GraphQLISODateTime

  facilityRef: String!

  context: [FacilityDiscountContext!]!

  discount: FacilityDiscountValue!

  priority: Int!

  type: FacilityDiscountPriceType!
}

union FacilityDiscountValue = FacilityDiscountAbsolute|FacilityDiscountRelative

type FacilityDiscountAbsolute {
  type: FacilityDiscountValueType!

  values: [FacilityDiscountAbsoluteElement]!
}

type FacilityDiscountAbsoluteElement {
  value: Int!

  decimalPlaces: Int!

  currency: CurrencyCode!
}

type FacilityDiscountRelative {
  type: FacilityDiscountValueType!

  value: Float!
}

enum FacilityDiscountContextTypes {
  CATEGORY

  FACILITY

  FACILITY_GROUP
}

enum FacilityDiscountContextOperator {
  NOT
}

enum FacilityDiscountValueType {
  ABSOLUTE

  RELATIVE
}

enum FacilityDiscountPriceType {
  SALES_PRICE
}

