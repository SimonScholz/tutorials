}

type AssignedRole {
  """
  Name of the assigned role
  """
  ref: String!

  """
  Context limitations for the user role assignment. These limitations restrict the assignment to specific contexts, such as facilities or zones.
  """
  context: [ContextLimitation!]

  """
  Context limitations for the user role assignment. These limitations restrict the assignment to specific contexts, such as facilities or zones.
  """
  contextLimitations: [ContextLimitation!] @deprecated(reason: "Use context instead")

  """
  The effective context limitations which apply to the role assignment, either from the assignment directly, or inherited from the role
  """
  effectiveContextLimitations: [ContextLimitation!]

  """
  List of permissions for the assigned role. Might be null if missing privileges.
  """
  permissions: [PermissionKey!]

  """
  Whether the role is an (immutable) basic role.
  """
  isBasicRole: Boolean!

  """
  Limitations when assigning this role
  """
  assignmentLimitations: [ContextLimitation!]

  """
  The role associated with the assigned role
  """
  role: Role
}

type ContextLimitation {
  """
  The type of the context limitation.
  """
  type: ContextTypes!

  """
  An array defining the values the user is allowed to access — if the entire context object is omitted, no access restrictions apply, whereas an empty array explicitly grants no access (i.e., maximum restriction).
  """
  values: [String!]!

  """
  The facilities of a context limitation of type facility. Undefined if not applicable.
  """
  facilities: [Facility!] @deprecated(reason: "use basefacilities")

  """
  The facilities of a context limitation of type facility. Undefined if not applicable.
  """
  baseFacilities: [BaseFacility!]

  """
  The facility groups associated with this context limitation
  """
  facilityGroups: [FacilityGroup!]

  """
  The roles of a context limitation of type role. Undefined if not applicable.
  """
  roles: [Role!]
}

"""
Available contexts in the fft platform
"""
enum ContextTypes {
  FACILITY

  FACILITY_GROUP

  ROLE

  USER_ROLE

  ZONE
}

type Role {
  """
  The name of the role, which must be unique and is used to identify the role.
  """
  name: String!

  """
  The permissions associated with the role, which define what actions the role can perform.
  """
  permissions: [PermissionKey!]!

  """
  An array of context objects, each defining a type and its allowed values — if a type is omitted, access for that type is unrestricted; if included, access is limited to the specified values, and each type must appear at most once.
  """
  context: [ContextLimitation!]

  """
  Deprecated: Use context instead.
  """
  contexts: [ContextLimitation!] @deprecated(reason: "Use context instead")

  """
  Deprecated: Use context instead.
  """
  contextLimitations: [ContextLimitation!] @deprecated(reason: "Use context instead")

  """
  The date when the role was created.
  """
  created: GraphQLISODateTime!

  """
  Whether the role is an (immutable) basic role.
  """
  isBasicRole: Boolean!

  """
  The date when the role was last modified.
  """
  lastModified: GraphQLISODateTime!

  """
  The description of the role, which provides more details about its purpose.
  """
  description: String

  """
  The display name of the role, which is used for user interfaces and may differ from the name (defaults to name if not provided).
  """
  displayName: String!

  version: Int!

  customAttributes: GraphQLJSON

  """
  Amount of users who have this role assigned
  """
  userCount: Int

  """
  Limitations when assigning this role
  """
  assignmentLimitations: [ContextLimitation!]
}

