  The amount of minutes after which an automated reroute is executed
  """
  rerouteAfterMinutes: Int!

  """
  Only pickjobs within the target time window are considered for reroute.
  """
  rerouteTargetTimeHours: Int!

  """
  How many minutes before a time triggered reroute a notification should be sent. Should be smaller than rerouteAfterMinutes
  """
  leadTimeBeforeTimeTriggeredReroute: Int

  rerouteStartedJobs: RerouteStartedJobsConfiguration
}

type RerouteStartedJobsConfiguration {
  """
  If true, the reroute will be executed for jobs that are already started.
  """
  active: Boolean!

  """
  The minimum time in minutes that a job must be in a started status (eg. PAUSED, IN_PROGRESS) before it should be rerouted. This is to ensure that jobs are not rerouted too quickly after they have last been modified.
  """
  minimumStartedTimeInMinutes: Int
}

input RerouteTimeTriggeredConfigurationInput {
  version: Int!

  clickAndCollectReroute: RerouteConfigurationInput!

  shipFromStoreDeliveryReroute: RerouteConfigurationInput!

