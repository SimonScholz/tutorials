input CreateFacilityDiscountInput {
  facilityRef: String!

  context: [FacilityDiscountContextInput!]!

  """
  It is only allowed to provide either absolute or relative discount.
  One of both must be provided.
  """
  absolutDiscount: FacilityDiscountAbsoluteInput

  relativeDiscount: FacilityDiscountRelativeInput

  """
  The priority of the discount. Discounts with the lowest priority value are
  applied first. Must be greater than 0 and smaller than 1000.
  """
  priority: Int!

  type: FacilityDiscountPriceType!
}

input FacilityDiscountContextInput {
  type: FacilityDiscountContextTypes!

  values: [String!]!

  operator: FacilityDiscountContextOperator
}

input UpdateFacilityDiscountInput {
  id: String!

  version: Int!

  facilityRef: String!

  context: [FacilityDiscountContextInput!]

  """
  It is only allowed to provide either absolute or relative discount.
  """
  absolutDiscount: FacilityDiscountAbsoluteInput

  relativeDiscount: FacilityDiscountRelativeInput

  """
  The priority of the discount. Discounts with the lowest priority value are
  applied first. Must be greater than 0 and smaller than 1000.
  """
  priority: Int

  type: FacilityDiscountPriceType
}

input FacilityDiscountRelativeInput {
  value: Float!
}

input FacilityDiscountAbsoluteInput {
  values: [FacilityDiscountAbsoluteElementInput]!
}

input FacilityDiscountAbsoluteElementInput {
  value: Int!

  decimalPlaces: Int!

  currency: CurrencyCode!
}

input DeleteFacilityDiscountInput {
  id: String!

  facilityRef: String!
}

