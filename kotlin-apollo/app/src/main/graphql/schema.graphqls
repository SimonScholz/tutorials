type SubstituteLineItem {
  id: ID!

  """
  This id is used to identify if this line item is related to the line item of other operational entities.
  """
  globalLineItemId: String

  article: SubstituteLineItemArticle!

  pickedAt: GraphQLISODateTime

  """
  quantity of the specific article that needs to be picked to substitute the item
  """
  quantity: Int!

  """
  The amount of articles that were picked for this pickline.
  """
  picked: Int

  scannableCodes: [String!]

  """
  This field allows you to rank substitutes against each other. The lowest number is the most preferrable substitute.
  """
  priority: Int

  measurementValidation: MeasurementValidation

  """
  Identifier for items unit of measurement.
  """
  measurementUnitKey: String

  """
  Identifier for items unit of measurement. E.g. measurementUnitKey is pieces and secondaryQuantity is gram
  """
  secondaryMeasurementUnitKey: String

  """
  secondary quantity of this item, E.g. quantity is the count and secondaryQuantity is the weight
  """
  secondaryQuantity: Int

  """
  The secondary amount of articles that were picked for this pickline.
  """
  secondaryPicked: Int

  """
  Resolved from measurementUnitKey
