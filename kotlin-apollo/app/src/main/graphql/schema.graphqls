  BETA

  """
  This field is generally available and is covered under our SLA.
  """
  GA
}

"""
Enumeration defining strategies for error catching and management within GraphQL operations.
"""
enum CatchTo {
  """
  Catch the error and map the position to a result type that can contain either a value or an error.
  """
  RESULT

  """
  Catch the error and map the position to a nullable type. This type will be null in case of errors, not distinguishing between semantic null or error-induced null but simpler for some scenarios.
  """
  NULL

  """
  Throw the error. Allows parent positions to attempt recovery using `RESULT` or `NULL`. If unhandled by any parent, parsing stops.
  """
  THROW
}

