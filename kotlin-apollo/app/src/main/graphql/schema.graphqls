  allow tracking of specific values such as expiry dates on a set of items. They should describe physical identifiable properties of the stock and are not meant to be used for metadata (see "customAttributes" for that).
  """
  properties: [StockProperty!]!

  serializedProperties: String!

  receiptDate: GraphQLISODateTime!

  availableUntil: GraphQLISODateTime

  version: Int!

  customAttributes: GraphQLJSON

  """
  Describes conditions of a stock
      *`DEFECTIVE` - stock is defective, not usable for customer orders
  """
  conditions: [StockCondition!]

  """
  The listing this stock is associated with. Null if no listing exists or on error.
  """
  listing: Listing

  """
  The storage location this stock is associated with. Null if no storage location exists or on error.
  """
  storageLocation: StorageLocation
