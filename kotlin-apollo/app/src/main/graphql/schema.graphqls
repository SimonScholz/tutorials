interface ProcessHistoryLogMetaData {
  user: ProcessHistoryLogUser

  timestamp: GraphQLISODateTime!
}

type ProcessHistoryLog implements ProcessHistoryLogMetaData {
  id: ID!

  user: ProcessHistoryLogUser

  timestamp: GraphQLISODateTime!

  """
  Type of the log entry. Can be one of the predefined values from enum ProcessHistoryLogTypeCommon: ORDER_LIFECYCLE, ROUTING, FULFILLMENT, ORDER_MODIFICATION, COMMENT or a custom action type following the pattern '{Action_name} (ext. Action)' for external actions.
  """
  type: String!

  domain: ProcessHistoryDomainType!

  """
  Status of the domain entity at the time of the log entry. The value corresponds to the status enum of the domain:
  - ORDER: OrderStatus
  - PICKJOB: PickJobStatus
  - PACKJOB: PackJobStatus
  - PARCEL: ParcelStatus
  - HANDOVER: HandoverjobStatus
  - ROUTING_PLAN: RoutingPlanStatus
  - EXTERNAL_ACTION: null (no status)
  """
  status: String

  domainRef: String!

  version: Int

  eventCause: String

  info: String

  eventType: ProcessHistoryEventType!

  payload: ProcessHistoryPayload
}

