type SourcingOption {
  id: ID!

  runId: String!

  totalCosts: SourcingOptionCosts

  """
  The total calculated penalty we calculated for this option
  """
  totalPenalty: Float

  """
  Estimated delivery date in format YYYY-MM-DD
  """
  estimatedDeliveryDate: String

  """
  Estimated pickup date in format YYYY-MM-DD
  """
  estimatedPickupDate: String

  """
  The latest date at which this option is still valid in UTC (ISO8601 format)
  """
  validUntil: String

  """
  Facility/article listing details with custom attributes (for debugging)
  """
  listingDetails: [SourcingOptionListingDetails]

  nodes: [SourcingOptionNode!]!

  transfers: [SourcingOptionTransfer!]!

  nonAssignedOrderLineItems: [HandledItem]

  ratingResults: [RatingResult!]!
}

"""
Money type representing monetary value with currency
"""
type Money {
  """
  The monetary value
  """
  value: Float!

  """
  ISO 4217 currency code (e.g., EUR, USD)
  """
  currency: CurrencyCode!

  """
  Number of decimal places for this amount
  """
  decimalPlaces: Int
}

type SourcingOptionListingDetails {
  """
  Reference to the facility
  """
  facilityRef: String

  """
  Tenant article ID
  """
  tenantArticleId: String

  """
  Custom attributes for this listing (key-value pairs)
  """
  customAttributes: GraphQLJSON
}

type SourcingOptionSalesPrice {
  """
  The tenant article id of the item
  """
  tenantArticleId: String!

  """
  The amount of the item in the solution
  """
  amount: Float!

  """
  Sales price per unit without discount (new Money format)
  """
  salesPricePerUnitWithoutDiscountAmount: Money!

  """
  Sales price per unit with discount applied (new Money format)
  """
  salesPricePerUnitWithDiscountAmount: Money

  """
  Applied discounts for this item
  """
  discount: [GraphQLJSON]

  """
  The facility reference of the source facility
  """
  sourceFacilityRef: String!

  """
  The tenant facility id of the source facility
  """
  sourceTenantFacilityId: String
}

type SourcingOptionCosts {
  """
  Total costs in Money format (replaces cost/currency)
  """
  totalCosts: Money

  """
  Total sales price amount in Money format (replaces totalSalesPrice)
  """
  totalSalesPriceAmount: Money

  """
  Sales prices and applied discounts of individual items (only present if costComponentRating is enabled)
  """
  salesPrices: [SourcingOptionSalesPrice!]!

  totalShippingCosts: ShippingCosts
}

type ShippingCosts {
  """
  Combined total transport cost in Money format (replaces totalTransportCost)
  """
  totalTransportCostAmount: Money!

  """
  Costs of the individual packaging units
  """
  packageCosts: [PackageCost]
}

type PackageCost {
  """
  Name of the package
  """
  packageName: String!

  """
  Cost of the package in Money format (replaces cost)
  """
  costAmount: Money!
}

type SourcingOptionNode {
  """
  id of this node, unique for this Sourcing Option Responses
  """
  id: String!

  """
  Reference to the facility
  """
  facilityRef: String

  facility: Facility

  """
  Tenant-specific facility ID
  """
  tenantFacilityId: String

  """
  Type of the node
  """
  type: NodeType!

  """
  List of handled items
  """
  lineItems: [HandledItem!]!

  """
  Indicates if this node is a pick-up location
  """
  isPickUpLocation: Boolean
}

enum NodeType {
  SUPPLIER

  MANAGED_FACILITY

  CUSTOMER
}

type HandledItem {
  """
  Tenant article ID
  """
  tenantArticleId: String!

  """
  Quantity
  """
  quantity: Float
}

type SourcingOptionTransfer {
  sourceNodeRef: String!

  targetNodeRef: String!

  facilityConnectionRef: String

  """
  Carrier information
  """
  carrier: SourcingOptionTransferCarrier

  lineItems: [HandledItem!]!

  timeLine: TransferTimeLine

  packagingInformation: [SourcingOptionsTransferPackagingInformation!]!
}

type SourcingOptionsTransferPackagingInformation {
  packagingUnit: PackagingUnit!

  packedItems: [HandledItem!]!

  """
  Total costs in Money format (replaces costs)
  """
  totalCosts: Money!
}

type SourcingOptionTransferCarrier {
  carrierName: String

  carrierKey: String

  logoUrl: String
}

type TransferTimeLine {
  """
  The date and time from which all time-related calculations for the corresponding items are based
  """
  calculationStartPoint: GraphQLISODateTime!

  """
  The earliest date and time when picking for the corresponding items can begin
  """
  earliestPickingStart: GraphQLISODateTime!

  """
  The latest date and time when picking for the corresponding items can begin
  """
  latestPickingStart: GraphQLISODateTime!

  """
  The desired date and time by which the corresponding items should be fulfilled
  """
  targetTime: GraphQLISODateTime!

  """
  The earliest date at which the corresponding items can be delivered to the recipient
  """
  earliestPossibleDeliveryTime: GraphQLISODateTime

  """
  The raw amount of transit days used for timeline calculation
  """
  usedTransitTimeInDays: Float
}

type RatingResult {
  id: String!

  penalty: Float!

  """
  The type of the rating, e.g. 'StandardRating' or 'ToolkitRating'
  """
  type: String!

  routingStrategyNodeId: String!

  name: String!
}

type SourcingOptionsExecutionResults {
  totalRatingResults: [SourcingOptionTotalRatingResult]
}

type SourcingOptionTotalRatingResult {
