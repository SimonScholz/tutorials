type PickJob implements VersionedResource {
  operativeProcessRef: String

  usersModificationHistory: [UserModificationHistory!]

  editor: Editor

  version: Int!

  created: GraphQLISODateTime

  lastModified: GraphQLISODateTime

  id: ID!

  tags: [TagReference!]

  documents: [PrintableDocument!]

  """
  A short identifier that helps assigning a pickJob to a customer. This is automatically created during creation.
  """
  shortId: String!

  """
  Indicates if gdpr related data was anonymized
  """
  anonymized: Boolean

  """
  The id of the order reference. The given ID has to be present in the system.
  """
  orderRef: String

  """
  The date this order was created at the supplying system.
  """
  orderDate: GraphQLISODateTime!

  """
  Field can be used as a reference number in foreign systems, for example as a reference to the source system's identifier for this order.
  """
  tenantOrderId: String

  """
  The id of the facility reference. The given ID has to be present in the system.
  """
  facilityRef: String!

  facility: Facility! @deprecated(reason: "Use baseFacility instead")

  """
  Pickjob this facility belongs to.
  """
  baseFacility: BaseFacility

  status: PickJobStatus!

  pickLineItems: [PickLineItem!]!

  expectedPickLineItems: [ExpectedPickLineItem!]

  deliveryInformation: DeliveryInformation

  """
  Attributes that can be added to the pickjob. These attributes cannot be used within fulfillment processes, but it could be useful to have the informations carried here.
  """
  customAttributes: GraphQLJSON

  shipments: [Shipment!]!

  loadUnits(locale: String @deprecated(reason: "locale from user will be considered")): [LoadUnit!]!

  handoverJobs: [HandoverJob!]!

  packJobs: [PackJob!]

  order: Order

  """
  Pick run id to which the pick job belongs
  """
  pickRunRef: String

  pickRun: PickRun

  documentHandling: DocumentHandling

  documentsRef: String

  resetBlocked: Boolean

  needsPacking: Boolean

  stickers: [Sticker!]

  """
  The reason for the current status. Currently, only reroute reasons are supported.
  """
  statusReason: String @deprecated(reason: "Use subStatus instead. This field is maintained for backward compatibility.")

  """
  The reason for the current status, providing additional context beyond the status field.
  Uses type-safe enum values for structured status information.
  """
  subStatus: PickJobSubStatus

  preferredPickingMethods: [PickingMethodEnum]

  pickingZones: [PickingZone!]

  paymentInformation: PaymentInformation

  availableActions: AvailablePickJobActions

  transfers: [OperativeTransfer!]

  operativeProcess: OperativeProcess

  pickingTimes: PickJobPickingTimes

  assignedUsers: [AssignedUser!]

  processRef: String
}

