  The id of this entity. It is generated during creation automatically and suits as the primary identifier of the described entity.
  """
  id: ID!

  """
  The version of the document to be used in optimistic locking mechanisms.
  """
  version: Int!

  """
  The date this entity was created at the platform. This value is generated by the service.
  """
  created: GraphQLISODateTime!

  """
  The date this entity was modified last. This value is generated by the service.
  """
  lastModified: GraphQLISODateTime!

  """
  Localized description of this container, sourced from the linked OperativeContainerType.
  """
  descriptionLocalized: GraphQLJSON

  """
  Localized name of this container, sourced from the linked OperativeContainerType.
  """
  nameLocalized: GraphQLJSON

  """
  URL to an icon representing this container type, sourced from the linked OperativeContainerType.
  """
  iconUrl: String

  """
  Attributes that can be added to this container. These attributes cannot be used within fulfillment processes, but it could be useful to have the information carried here.
  """
  customAttributes: GraphQLJSON

  """
  Translated description, filled on request based on nameLocalized.
  """
  name: String

  """
  Translated name, filled on request based on descriptionLocalized.
  """
  description: String

  """
  Id of the facility this container is used in.
  """
  facilityRef: String!

  """
  Ids of the ServiceJobs this container belongs to.
  """
  serviceJobRefs: [String!]!

  """
  Reference to the stack this container belongs to.
  """
  stackRef: String

  """
  The type of this container, either VIRTUAL or PHYSICAL.
  """
  type: ServiceContainerType!

  """
  The line items that are contained in this service container.
  """
  lineItems: [ServiceContainerLineItem!]!

  """
  Codes that can be used for scanning this container.
  """
  scannableCodes: [String!]

  """
  Id of the storage location this container is located at.
  """
  storageLocationRef: String

  """
  Weight limit of the container in grams, sourced from the linked OperativeContainerType.
  """
  weightLimitInG: Float

  """
  Physical dimensions of this container, sourced from the linked OperativeContainerType.
  """
  dimensions: ContainerDimensions

  """
  Reference to the operative container type this container is based on.
  """
  operativeContainerTypeRef: String
}

