type MoveEachesToContainerResponse {
  """
  The updated connected pack job after moving eaches to the target container.
  """
  packJob: PackJob!
}

input PackJobMoveEachesToContainerInput {
  """
  The id of the connected pack job from the containers
  """
  packJobId: String!

  """
  multiple move actions to perform in one request
  """
  moves: [MoveEachesToContainerInput!]!
}

input MoveEachesToContainerInput {
  """
  Containers to move the eaches from (will be removed here)
  """
  from: [MoveEachesToContainerFromInput!]!

  """
  Containers to move the eaches to (will be added here). Must be a PackingTargetContainer. If MoveEachesToTargetContainerInput is passed, a new container will be created
  """
  to: MoveEachesToContainerToInput!
}

input PackJobMoveEachesToNewContainerInput {
  """
  The id of the connected pack job from the containers
  """
  packJobId: String!

  """
  multiple move actions to perform in one request
  """
  moves: [MoveEachesToNewContainerInput!]!
}

input MoveEachesToNewContainerInput {
  """
  Containers to move the eaches from (will be removed here)
  """
  from: [MoveEachesToContainerFromInput!]!

  """
  Containers to move the eaches to (will be added here). Must be a PackingTargetContainer. If MoveEachesToTargetContainerInput is passed, a new container will be created
  """
  to: MoveEachesToNewContainerToInput!
}

input MoveEachesToNewContainerToInput {
  """
  Type of the new container to create. Either PackingSourceContainer or PackingTargetContainer
  """
  type: MoveEachesToNewContainerType!

  """
  Id of a existing operative container type to create the new container from
  """
  operativeContainerTypeRef: String!

  """
  Codes that identify the container
  """
  codes: [String!]
}

enum MoveEachesToNewContainerType {
  PACKING_SOURCE_CONTAINER

  PACKING_TARGET_CONTAINER
}

input MoveEachesToContainerFromInput {
  """
  id of the container to move the eaches from
  """
  containerId: String!

  """
  version of the container to move the eaches from
  """
  containerVersion: Int!

  """
  amount of eaches to move from the container
  """
  quantity: Int!

  """
  amount of secondary eaches to move from the container
  """
  secondaryQuantity: Int

  """
  id of the line item to move from the container
  """
  globalLineItemId: String!
}

input MoveEachesToContainerToInput {
  """
  Type of the container you want to move to. Either PackingSourceContainer or PackingTargetContainer
  """
  type: MoveEachesToNewContainerType!

  """
  id of the container to move the eaches to
  """
  containerId: String!

  """
  version of the container to move the eaches to
  """
  containerVersion: Int!
}

